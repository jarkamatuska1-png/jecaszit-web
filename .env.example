# Kopie pro místní vývoj: zkopíruj do .env.local a doplň hodnoty.
# .env.local NIKDY nepatří do gitu. Na produkci se vkládá na Vercelu.

# Ecomail — sběr kontaktů (povinné)
ECOMAIL_API_KEY=
ECOMAIL_LIST_ID_JECASZIT=29

# Ověření webu ve webmasterských nástrojích (nepovinné).
# Když zůstanou prázdné, do stránky se nevypíše žádná značka.
SEZNAM_WMT_KOD=
BING_WMT_KOD=
